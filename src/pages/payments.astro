---
import AdminLayout from "../layouts/AdminLayout.astro";
import { AdminApiError } from "../lib/server/api-client";
import { listOpsPayments, opsExportPath } from "../lib/server/ops-service";
import type { OpsPaymentSummary } from "../lib/ops/types";

const session = Astro.locals.adminSession;
if (!session) {
  return Astro.redirect("/login", 302);
}

const status = Astro.url.searchParams.get("status") ?? "";
const search = Astro.url.searchParams.get("search") ?? "";
const page = Math.max(Number(Astro.url.searchParams.get("page") ?? "0") || 0, 0);

let payments: OpsPaymentSummary[] = [];
let hasMore = false;
let reconciliationEndpoint = "/api/v1/admin/payments/transactions";
let errorMessage = "";

try {
  const response = await listOpsPayments(session.accessToken, { status, search, page, size: 20 });
  payments = response.payments;
  hasMore = response.hasMore;
  reconciliationEndpoint = response.reconciliationEndpoint || reconciliationEndpoint;
}
catch (error) {
  errorMessage = error instanceof AdminApiError ? error.message : "Impossible de charger les paiements.";
}

const exportHref = opsExportPath("payments", { status: status || undefined, search: search || undefined });
const statusOptions = ["", "INITIATED", "PENDING_CALLBACK", "CONFIRMED", "FAILED", "EXPIRED", "REFUNDED"];

function formatDate(value: string | null | undefined): string {
  if (!value) return "-";
  return new Intl.DateTimeFormat("fr-CM", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
}

function formatAmount(value: number, currency: string): string {
  return `${new Intl.NumberFormat("fr-CM").format(Number(value))} ${currency}`;
}

function pageHref(targetPage: number): string {
  const params = new URLSearchParams();
  if (status) params.set("status", status);
  if (search) params.set("search", search);
  if (targetPage > 0) params.set("page", String(targetPage));
  return `/payments?${params.toString()}`;
}
---

<AdminLayout title="Paiements" eyebrow="Pilotage">
  {
    errorMessage && (
      <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">
        {errorMessage}
      </p>
    )
  }

  <p class="mb-4 rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
    Transactions wallet (depots et paiements trajet). Pour la reconciliation Mobile Money detaillee :
    <a class="font-medium text-brand-700 hover:underline" href="/reconciliation">ouvrir Reconciliation</a>
    <span class="text-xs"> ({reconciliationEndpoint})</span>.
  </p>

  <form method="get" action="/payments" class="mb-5 flex flex-wrap items-end gap-3 border-b border-line pb-5">
    <div>
      <label for="search" class="block text-sm font-medium text-ink">Recherche</label>
      <input
        id="search"
        name="search"
        value={search}
        placeholder="Reference, telephone, id"
        class="mt-2 rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
      />
    </div>
    <div>
      <label for="status" class="block text-sm font-medium text-ink">Statut</label>
      <select
        id="status"
        name="status"
        class="mt-2 rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
      >
        {
          statusOptions.map((option) => (
            <option value={option} selected={status === option}>
              {option || "Tous"}
            </option>
          ))
        }
      </select>
    </div>
    <button type="submit" class="rounded-md bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-900">
      Filtrer
    </button>
    <a href={exportHref} class="rounded-md border border-line px-4 py-2 text-sm font-medium hover:bg-surface">
      Export CSV
    </a>
  </form>

  <section class="rounded-lg border border-line bg-white shadow-panel">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-semibold">Transactions</h3>
      <p class="text-sm text-muted">{payments.length} transaction(s) sur cette page.</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[780px] text-left text-sm">
        <thead class="bg-surface text-xs uppercase text-muted">
          <tr>
            <th class="px-5 py-3">Reference</th>
            <th class="px-5 py-3">Type</th>
            <th class="px-5 py-3">Statut</th>
            <th class="px-5 py-3">Montant</th>
            <th class="px-5 py-3">Telephone</th>
            <th class="px-5 py-3">Date</th>
          </tr>
        </thead>
        <tbody>
          {
            payments.length === 0 ? (
              <tr>
                <td class="px-5 py-4 text-muted" colspan="6">Aucune transaction.</td>
              </tr>
            ) : (
              payments.map((item) => (
                <tr class="border-t border-line">
                  <td class="px-5 py-4 font-medium">{item.externalReference ?? item.id.slice(0, 8)}</td>
                  <td class="px-5 py-4">{item.type}</td>
                  <td class="px-5 py-4">{item.status}</td>
                  <td class="px-5 py-4">{formatAmount(item.amount, item.currency)}</td>
                  <td class="px-5 py-4 text-muted">{item.payerPhone ?? "-"}</td>
                  <td class="px-5 py-4 text-muted">{formatDate(item.initiatedAt)}</td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
    <div class="flex items-center justify-between border-t border-line px-5 py-3 text-sm">
      {
        page > 0 ? (
          <a href={pageHref(page - 1)} class="font-medium text-brand-700 hover:underline">Precedent</a>
        ) : (
          <span class="text-muted">Precedent</span>
        )
      }
      <span class="text-muted">Page {page + 1}</span>
      {
        hasMore ? (
          <a href={pageHref(page + 1)} class="font-medium text-brand-700 hover:underline">Suivant</a>
        ) : (
          <span class="text-muted">Suivant</span>
        )
      }
    </div>
  </section>
</AdminLayout>
