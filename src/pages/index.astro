---
import AdminLayout from "../layouts/AdminLayout.astro";
import MetricCard from "../components/MetricCard.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { AdminApiError } from "../lib/server/api-client";
import { getOpsOverview, listOpsBookings, listOpsPayments } from "../lib/server/ops-service";
import { emptyOpsOverview, type OpsBookingSummary, type OpsOverview, type OpsPaymentSummary } from "../lib/ops/types";

const session = Astro.locals.adminSession;
if (!session) {
  return Astro.redirect("/login", 302);
}

let overview: OpsOverview = emptyOpsOverview();
let recentBookings: OpsBookingSummary[] = [];
let recentPayments: OpsPaymentSummary[] = [];
let errorMessage = "";

try {
  overview = await getOpsOverview(session.accessToken);
}
catch (error) {
  overview = emptyOpsOverview();
  errorMessage = error instanceof AdminApiError
    ? error.message
    : "Impossible de charger le tableau de bord operations.";
}

try {
  const [bookingsPage, paymentsPage] = await Promise.all([
    listOpsBookings(session.accessToken, { size: 5 }),
    listOpsPayments(session.accessToken, { size: 5 })
  ]);
  recentBookings = bookingsPage.bookings;
  recentPayments = paymentsPage.payments;
}
catch {
  // Keep overview usable even if secondary lists fail.
}

const cards = [
  {
    label: "Utilisateurs",
    value: formatCount(overview.usersTotal),
    detail: statusSummary(overview.usersByStatus),
    href: "/users"
  },
  {
    label: "Annonces actives",
    value: formatCount(overview.announcementsActive),
    detail: statusSummary(overview.announcementsByStatus),
    href: "/announcements"
  },
  {
    label: "Reservations",
    value: formatCount(sumCounts(overview.bookingsByStatus)),
    detail: statusSummary(overview.bookingsByStatus),
    href: "/bookings"
  },
  {
    label: "Paiements du jour",
    value: `${formatCount(overview.paymentsConfirmedToday)} / ${formatCount(overview.paymentsPendingToday)}`,
    detail: "Confirmes / en attente (Africa/Douala)",
    href: "/payments"
  }
];

function formatCount(value: number): string {
  return new Intl.NumberFormat("fr-CM").format(value ?? 0);
}

function sumCounts(counts: Record<string, number>): number {
  return Object.values(counts ?? {}).reduce((total, item) => total + item, 0);
}

function statusSummary(counts: Record<string, number>): string {
  const entries = Object.entries(counts ?? {});
  if (entries.length === 0) {
    return "Aucune donnee";
  }
  return entries
    .slice(0, 3)
    .map(([status, total]) => `${status}: ${formatCount(total)}`)
    .join(" · ");
}

function formatDate(value: string | null | undefined): string {
  if (!value) {
    return "-";
  }
  return new Intl.DateTimeFormat("fr-CM", {
    dateStyle: "medium",
    timeStyle: "short"
  }).format(new Date(value));
}

function formatMoney(value: number, currency = "XAF"): string {
  return `${new Intl.NumberFormat("fr-CM").format(value ?? 0)} ${currency}`;
}

function shortId(value: string): string {
  return value.slice(0, 8);
}
---

<AdminLayout title="Dashboard operations" eyebrow="Pilotage">
  {
    errorMessage && (
      <p class="alert-warn" role="status">
        {errorMessage} Affichage de secours vide.
      </p>
    )
  }

  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {
      cards.map((item) => (
        <MetricCard label={item.label} value={item.value} detail={item.detail} href={item.href} />
      ))
    }
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-2">
    <div class="panel overflow-hidden">
      <div class="flex items-center justify-between border-b border-line px-5 py-4">
        <div>
          <h3 class="font-display font-semibold">Reservations recentes</h3>
          <p class="text-sm text-muted">Dernieres demandes interurbaines.</p>
        </div>
        <a href="/bookings" class="text-sm font-medium text-brand-700 hover:underline">Voir tout</a>
      </div>
      <div class="overflow-x-auto">
        <table class="data-table min-w-[480px]">
          <thead>
            <tr>
              <th>Reference</th>
              <th>Statut</th>
              <th class="text-right">Places</th>
              <th>Demande</th>
            </tr>
          </thead>
          <tbody>
            {
              recentBookings.length === 0 ? (
                <tr>
                  <td class="empty-state" colspan="4">Aucune reservation recente.</td>
                </tr>
              ) : (
                recentBookings.map((item) => (
                  <tr>
                    <td class="font-data text-xs">{shortId(item.id)}</td>
                    <td><StatusBadge status={item.status} /></td>
                    <td class="num">{item.seatsRequested}</td>
                    <td class="text-muted">{formatDate(item.requestedAt)}</td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="panel overflow-hidden">
      <div class="flex items-center justify-between border-b border-line px-5 py-4">
        <div>
          <h3 class="font-display font-semibold">Paiements recents</h3>
          <p class="text-sm text-muted">{overview.paymentsNote ?? "Transactions wallet et trajets."}</p>
        </div>
        <a href="/payments" class="text-sm font-medium text-brand-700 hover:underline">Voir tout</a>
      </div>
      <div class="overflow-x-auto">
        <table class="data-table min-w-[480px]">
          <thead>
            <tr>
              <th>Reference</th>
              <th>Statut</th>
              <th class="text-right">Montant</th>
              <th>Initie</th>
            </tr>
          </thead>
          <tbody>
            {
              recentPayments.length === 0 ? (
                <tr>
                  <td class="empty-state" colspan="4">Aucune transaction recente.</td>
                </tr>
              ) : (
                recentPayments.map((item) => (
                  <tr>
                    <td class="font-data text-xs">{item.externalReference ?? shortId(item.id)}</td>
                    <td><StatusBadge status={item.status} /></td>
                    <td class="num">{formatMoney(Number(item.amount), item.currency)}</td>
                    <td class="text-muted">{formatDate(item.initiatedAt)}</td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</AdminLayout>
