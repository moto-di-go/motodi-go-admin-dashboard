---
import AdminLayout from "../layouts/AdminLayout.astro";
import { AdminApiError } from "../lib/server/api-client";
import { getOpsOverview, listOpsBookings, listOpsPayments } from "../lib/server/ops-service";
import { emptyOpsOverview, type OpsBookingSummary, type OpsOverview, type OpsPaymentSummary } from "../lib/ops/types";

const session = Astro.locals.adminSession;
if (!session) {
  return Astro.redirect("/login", 302);
}

let overview: OpsOverview = emptyOpsOverview();
let recentBookings: OpsBookingSummary[] = [];
let recentPayments: OpsPaymentSummary[] = [];
let errorMessage = "";

try {
  overview = await getOpsOverview(session.accessToken);
}
catch (error) {
  overview = emptyOpsOverview();
  errorMessage = error instanceof AdminApiError
    ? error.message
    : "Impossible de charger le tableau de bord operations.";
}

try {
  const [bookingsPage, paymentsPage] = await Promise.all([
    listOpsBookings(session.accessToken, { size: 5 }),
    listOpsPayments(session.accessToken, { size: 5 })
  ]);
  recentBookings = bookingsPage.bookings;
  recentPayments = paymentsPage.payments;
}
catch {
  // Keep overview usable even if secondary lists fail.
}

const cards = [
  {
    label: "Utilisateurs",
    value: formatCount(overview.usersTotal),
    detail: statusSummary(overview.usersByStatus),
    href: "/users"
  },
  {
    label: "Annonces actives",
    value: formatCount(overview.announcementsActive),
    detail: statusSummary(overview.announcementsByStatus),
    href: "/announcements"
  },
  {
    label: "Reservations",
    value: formatCount(sumCounts(overview.bookingsByStatus)),
    detail: statusSummary(overview.bookingsByStatus),
    href: "/bookings"
  },
  {
    label: "Paiements du jour",
    value: `${formatCount(overview.paymentsConfirmedToday)} / ${formatCount(overview.paymentsPendingToday)}`,
    detail: "Confirmes / en attente (Africa/Douala)",
    href: "/payments"
  }
];

function formatCount(value: number): string {
  return new Intl.NumberFormat("fr-CM").format(value ?? 0);
}

function sumCounts(counts: Record<string, number>): number {
  return Object.values(counts ?? {}).reduce((total, item) => total + item, 0);
}

function statusSummary(counts: Record<string, number>): string {
  const entries = Object.entries(counts ?? {});
  if (entries.length === 0) {
    return "Aucune donnee";
  }
  return entries
    .slice(0, 3)
    .map(([status, total]) => `${status}: ${formatCount(total)}`)
    .join(" · ");
}

function formatDate(value: string | null | undefined): string {
  if (!value) {
    return "-";
  }
  return new Intl.DateTimeFormat("fr-CM", {
    dateStyle: "medium",
    timeStyle: "short"
  }).format(new Date(value));
}

function shortId(value: string): string {
  return value.slice(0, 8);
}
---

<AdminLayout title="Dashboard operations" eyebrow="Pilotage">
  {
    errorMessage && (
      <p class="mb-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
        {errorMessage} Affichage de secours vide.
      </p>
    )
  }

  <section class="mb-5 flex flex-wrap gap-2 text-sm">
    <a href="/users" class="rounded-md border border-line bg-white px-3 py-2 font-medium hover:bg-surface">Utilisateurs</a>
    <a href="/announcements" class="rounded-md border border-line bg-white px-3 py-2 font-medium hover:bg-surface">Annonces</a>
    <a href="/bookings" class="rounded-md border border-line bg-white px-3 py-2 font-medium hover:bg-surface">Reservations</a>
    <a href="/payments" class="rounded-md border border-line bg-white px-3 py-2 font-medium hover:bg-surface">Paiements</a>
  </section>

  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {
      cards.map((item) => (
        <a href={item.href} class="rounded-lg border border-line bg-white p-5 shadow-panel hover:border-brand-700">
          <p class="text-sm text-muted">{item.label}</p>
          <strong class="mt-3 block text-2xl font-semibold">{item.value}</strong>
          <p class="mt-2 text-sm text-muted">{item.detail}</p>
        </a>
      ))
    }
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-2">
    <div class="rounded-lg border border-line bg-white shadow-panel">
      <div class="border-b border-line px-5 py-4">
        <h3 class="font-semibold">Reservations recentes</h3>
        <p class="text-sm text-muted">Dernieres demandes interurbaines.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[480px] text-left text-sm">
          <thead class="bg-surface text-xs uppercase text-muted">
            <tr>
              <th class="px-5 py-3">Reference</th>
              <th class="px-5 py-3">Statut</th>
              <th class="px-5 py-3">Places</th>
              <th class="px-5 py-3">Demande</th>
            </tr>
          </thead>
          <tbody>
            {
              recentBookings.length === 0 ? (
                <tr>
                  <td class="px-5 py-4 text-muted" colspan="4">Aucune reservation recente.</td>
                </tr>
              ) : (
                recentBookings.map((item) => (
                  <tr class="border-t border-line">
                    <td class="px-5 py-4 font-medium">{shortId(item.id)}</td>
                    <td class="px-5 py-4">{item.status}</td>
                    <td class="px-5 py-4">{item.seatsRequested}</td>
                    <td class="px-5 py-4 text-muted">{formatDate(item.requestedAt)}</td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="rounded-lg border border-line bg-white shadow-panel">
      <div class="border-b border-line px-5 py-4">
        <h3 class="font-semibold">Paiements recents</h3>
        <p class="text-sm text-muted">{overview.paymentsNote ?? "Transactions wallet et trajets."}</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[480px] text-left text-sm">
          <thead class="bg-surface text-xs uppercase text-muted">
            <tr>
              <th class="px-5 py-3">Reference</th>
              <th class="px-5 py-3">Statut</th>
              <th class="px-5 py-3">Montant</th>
              <th class="px-5 py-3">Initie</th>
            </tr>
          </thead>
          <tbody>
            {
              recentPayments.length === 0 ? (
                <tr>
                  <td class="px-5 py-4 text-muted" colspan="4">Aucune transaction recente.</td>
                </tr>
              ) : (
                recentPayments.map((item) => (
                  <tr class="border-t border-line">
                    <td class="px-5 py-4 font-medium">{item.externalReference ?? shortId(item.id)}</td>
                    <td class="px-5 py-4">{item.status}</td>
                    <td class="px-5 py-4">{formatCount(Number(item.amount))} {item.currency}</td>
                    <td class="px-5 py-4 text-muted">{formatDate(item.initiatedAt)}</td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</AdminLayout>
