---
import AdminLayout from "../layouts/AdminLayout.astro";
import { operationsOverview, recentOperations } from "../lib/mock-data";
---

<AdminLayout title="Dashboard operations" eyebrow="Pilotage">
  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {
      operationsOverview.map((item) => (
        <article class="rounded-lg border border-line bg-white p-5 shadow-panel">
          <p class="text-sm text-muted">{item.label}</p>
          <div class="mt-3 flex items-end justify-between gap-3">
            <strong class="text-2xl font-semibold">{item.value}</strong>
            <span class="rounded-full bg-brand-50 px-2 py-1 text-xs font-semibold text-brand-700">
              {item.trend}
            </span>
          </div>
          <p class="mt-2 text-sm text-muted">{item.detail}</p>
        </article>
      ))
    }
  </section>

  <section class="mt-6 rounded-lg border border-line bg-white shadow-panel">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-semibold">Activite recente</h3>
      <p class="text-sm text-muted">Vue operationnelle utilisateurs, annonces et transactions.</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead class="bg-surface text-xs uppercase text-muted">
          <tr>
            <th class="px-5 py-3">Reference</th>
            <th class="px-5 py-3">Type</th>
            <th class="px-5 py-3">Statut</th>
            <th class="px-5 py-3">Segment</th>
          </tr>
        </thead>
        <tbody>
          {
            recentOperations.map((item) => (
              <tr class="border-t border-line">
                <td class="px-5 py-4 font-medium">{item.id}</td>
                <td class="px-5 py-4">{item.type}</td>
                <td class="px-5 py-4">{item.status}</td>
                <td class="px-5 py-4 text-muted">{item.owner}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>

