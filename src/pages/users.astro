---
import AdminLayout from "../layouts/AdminLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { AdminApiError } from "../lib/server/api-client";
import { getOpsUser, listOpsUsers, opsExportPath } from "../lib/server/ops-service";
import type { OpsUserDetail, OpsUserSummary } from "../lib/ops/types";

const session = Astro.locals.adminSession;
if (!session) {
  return Astro.redirect("/login", 302);
}

const status = Astro.url.searchParams.get("status") ?? "";
const search = Astro.url.searchParams.get("search") ?? "";
const selectedUserId = Astro.url.searchParams.get("userId") ?? "";
const page = Math.max(Number(Astro.url.searchParams.get("page") ?? "0") || 0, 0);

let users: OpsUserSummary[] = [];
let hasMore = false;
let detail: OpsUserDetail | null = null;
let errorMessage = "";

try {
  const response = await listOpsUsers(session.accessToken, { status, search, page, size: 20 });
  users = response.users;
  hasMore = response.hasMore;
}
catch (error) {
  errorMessage = error instanceof AdminApiError ? error.message : "Impossible de charger les utilisateurs.";
}

if (selectedUserId) {
  try {
    detail = await getOpsUser(selectedUserId, session.accessToken);
  }
  catch (error) {
    errorMessage ||= error instanceof AdminApiError ? error.message : "Detail utilisateur indisponible.";
  }
}

const exportHref = opsExportPath("users", { status: status || undefined, search: search || undefined });
const statusOptions = ["", "ACTIVE", "PENDING_PHONE_VERIFICATION", "SUSPENDED", "DELETED"];

function formatDate(value: string | null | undefined): string {
  if (!value) return "-";
  return new Intl.DateTimeFormat("fr-CM", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
}

function userHref(userId: string): string {
  const params = new URLSearchParams();
  if (status) params.set("status", status);
  if (search) params.set("search", search);
  if (page > 0) params.set("page", String(page));
  params.set("userId", userId);
  return `/users?${params.toString()}`;
}

function pageHref(targetPage: number): string {
  const params = new URLSearchParams();
  if (status) params.set("status", status);
  if (search) params.set("search", search);
  if (selectedUserId) params.set("userId", selectedUserId);
  if (targetPage > 0) params.set("page", String(targetPage));
  return `/users?${params.toString()}`;
}
---

<AdminLayout title="Utilisateurs" eyebrow="Pilotage">
  {
    errorMessage && (
      <p class="alert-danger" role="alert">{errorMessage}</p>
    )
  }

  <form method="get" action="/users" class="filter-bar">
    <div>
      <label for="search" class="field-label">Recherche</label>
      <input
        id="search"
        name="search"
        value={search}
        placeholder="Telephone, nom, email, id"
        class="field-control"
      />
    </div>
    <div>
      <label for="status" class="field-label">Statut</label>
      <select id="status" name="status" class="field-control">
        {
          statusOptions.map((option) => (
            <option value={option} selected={status === option}>
              {option || "Tous"}
            </option>
          ))
        }
      </select>
    </div>
    <button type="submit" class="btn-primary">Filtrer</button>
    <a href={exportHref} class="btn-secondary">Export CSV</a>
  </form>

  <div class="grid gap-5 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
    <section class="panel overflow-hidden">
      <div class="border-b border-line px-5 py-4">
        <h3 class="font-display font-semibold">Liste</h3>
        <p class="text-sm text-muted">{users.length} utilisateur(s) sur cette page.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="data-table min-w-[640px]">
          <thead>
            <tr>
              <th>Nom</th>
              <th>Telephone</th>
              <th>Statut</th>
              <th class="text-right">Profils</th>
            </tr>
          </thead>
          <tbody>
            {
              users.length === 0 ? (
                <tr>
                  <td class="empty-state" colspan="4">Aucun utilisateur.</td>
                </tr>
              ) : (
                users.map((user) => (
                  <tr class:list={[user.id === selectedUserId ? "bg-brand-50" : ""]}>
                    <td>
                      <a href={userHref(user.id)} class="font-medium hover:text-brand-700">
                        {user.fullName || user.id.slice(0, 8)}
                      </a>
                    </td>
                    <td class="font-data text-xs text-muted">{user.phoneNumber ?? "-"}</td>
                    <td><StatusBadge status={user.status} /></td>
                    <td class="num">{user.profilesCount}</td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
      <div class="flex items-center justify-between border-t border-line px-5 py-3 text-sm">
        {
          page > 0 ? (
            <a href={pageHref(page - 1)} class="font-medium text-brand-700 hover:underline">Precedent</a>
          ) : (
            <span class="text-muted">Precedent</span>
          )
        }
        <span class="font-data text-muted">Page {page + 1}</span>
        {
          hasMore ? (
            <a href={pageHref(page + 1)} class="font-medium text-brand-700 hover:underline">Suivant</a>
          ) : (
            <span class="text-muted">Suivant</span>
          )
        }
      </div>
    </section>

    <section class="panel overflow-hidden">
      {
        !detail ? (
          <div class="empty-state">Selectionnez un utilisateur pour voir ses profils.</div>
        ) : (
          <>
            <div class="border-b border-line px-5 py-4">
              <h3 class="font-display font-semibold">{detail.fullName || "Utilisateur"}</h3>
              <p class="text-sm text-muted">
                <span class="font-data">{detail.phoneNumber ?? "-"}</span>
                {" · "}
                <StatusBadge status={detail.status} />
              </p>
            </div>
            <div class="space-y-3 px-5 py-4 text-sm">
              <p>Email: {detail.email ?? "-"}</p>
              <p>Locale: {detail.locale ?? "-"}</p>
              <p>Cree: {formatDate(detail.createdAt)}</p>
              <p>Telephone verifie: {formatDate(detail.phoneVerifiedAt)}</p>
            </div>
            <div class="border-t border-line px-5 py-4">
              <h4 class="font-display font-semibold">Profils</h4>
              <div class="mt-3 divide-y divide-line rounded-md border border-line">
                {
                  detail.profiles.length === 0 ? (
                    <p class="px-4 py-3 text-sm text-muted">Aucun profil.</p>
                  ) : (
                    detail.profiles.map((profile) => (
                      <div class="px-4 py-3 text-sm">
                        <p class="font-medium">{profile.displayName || profile.type}</p>
                        <p class="mt-1 flex flex-wrap items-center gap-2 text-muted">
                          <span>{profile.type}</span>
                          <StatusBadge status={profile.validationStatus} />
                          {profile.active ? <span class="status-badge status-info">actif</span> : null}
                        </p>
                      </div>
                    ))
                  )
                }
              </div>
            </div>
          </>
        )
      }
    </section>
  </div>
</AdminLayout>
