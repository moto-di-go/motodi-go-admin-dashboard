---
import AdminLayout from "../layouts/AdminLayout.astro";
import { hasAnyPermission } from "../lib/auth/rbac";
import { AdminApiError } from "../lib/server/api-client";
import {
  applyModerationAction,
  getSupportTicket,
  listModerationQueue,
  listSupportTickets,
  updateSupportTicket
} from "../lib/server/moderation-service";
import type {
  ModerationAction,
  ModerationQueueItem,
  ModerationTab,
  SupportTicketCategory,
  SupportTicketDetail,
  SupportTicketPriority,
  SupportTicketStatus,
  SupportTicketSummary
} from "../lib/moderation/types";

const session = Astro.locals.adminSession;
if (!session) {
  return Astro.redirect("/login", 302);
}

const canWrite = hasAnyPermission(session, ["MODERATION_WRITE"]);

const categoryOptions: Array<SupportTicketCategory | ""> = [
  "",
  "TRANSPORT",
  "PAYMENT",
  "ACCOUNT",
  "SECURITY",
  "EMERGENCY"
];
const priorityOptions: Array<SupportTicketPriority | ""> = ["", "LOW", "MEDIUM", "HIGH", "URGENT"];
const statusOptions: Array<SupportTicketStatus | ""> = [
  "",
  "OPEN",
  "IN_PROGRESS",
  "WAITING_USER",
  "RESOLVED",
  "CLOSED"
];
const ratingActions: Array<{ action: ModerationAction; label: string; tone: "default" | "danger" | "brand" }> = [
  { action: "HIDE", label: "Masquer", tone: "danger" },
  { action: "RESTORE", label: "Restaurer", tone: "brand" },
  { action: "ESCALATE", label: "Escalader", tone: "default" }
];

const categoryLabels: Record<string, string> = {
  TRANSPORT: "Transport",
  PAYMENT: "Paiement",
  ACCOUNT: "Compte",
  SECURITY: "Securite",
  EMERGENCY: "Urgence"
};
const priorityLabels: Record<string, string> = {
  LOW: "Basse",
  MEDIUM: "Moyenne",
  HIGH: "Haute",
  URGENT: "Urgente"
};
const statusLabels: Record<string, string> = {
  OPEN: "Ouvert",
  IN_PROGRESS: "En cours",
  WAITING_USER: "En attente utilisateur",
  RESOLVED: "Resolu",
  CLOSED: "Clos",
  FLAGGED: "Signale"
};

function normalizeTab(value: string | null | undefined): ModerationTab {
  return value === "tickets" ? "tickets" : "ratings";
}

function normalizeOption<T extends string>(value: string | null | undefined, options: readonly T[]): T | "" {
  if (!value) return "";
  return options.includes(value as T) ? (value as T) : "";
}

let tab = normalizeTab(Astro.url.searchParams.get("tab"));
let category = normalizeOption(Astro.url.searchParams.get("category"), categoryOptions);
let priority = normalizeOption(Astro.url.searchParams.get("priority"), priorityOptions);
let status = normalizeOption(Astro.url.searchParams.get("status"), statusOptions);
let selectedTicketId = Astro.url.searchParams.get("ticketId") ?? "";
let page = Math.max(Number(Astro.url.searchParams.get("page") ?? "0") || 0, 0);
let errorMessage = "";
let successMessage = "";

if (Astro.url.searchParams.get("action") === "success") {
  successMessage = "Action de moderation enregistree.";
}
if (Astro.url.searchParams.get("ticket") === "success") {
  successMessage = "Ticket support mis a jour.";
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") ?? "").trim();
  tab = normalizeTab(String(form.get("tab") ?? tab));
  category = normalizeOption(String(form.get("category") ?? category), categoryOptions);
  priority = normalizeOption(String(form.get("priority") ?? priority), priorityOptions);
  status = normalizeOption(String(form.get("status") ?? status), statusOptions);
  selectedTicketId = String(form.get("ticketId") ?? selectedTicketId).trim();
  page = Math.max(Number(form.get("page") ?? page) || 0, 0);

  if (!canWrite) {
    errorMessage = "Votre session ne contient pas la permission MODERATION_WRITE.";
  }
  else if (intent === "moderation-action") {
    const targetId = String(form.get("targetId") ?? "").trim();
    const action = String(form.get("action") ?? "").trim().toUpperCase() as ModerationAction;
    const reason = String(form.get("reason") ?? "").trim();
    const allowedActions: ModerationAction[] = ["HIDE", "RESTORE", "ESCALATE"];

    if (!targetId || !allowedActions.includes(action)) {
      errorMessage = "Action de moderation invalide.";
    }
    else {
      try {
        await applyModerationAction(session.accessToken, {
          targetType: "RATING",
          targetId,
          action,
          reason: reason || null
        });
        const params = new URLSearchParams();
        params.set("tab", "ratings");
        if (page > 0) params.set("page", String(page));
        params.set("action", "success");
        return Astro.redirect(`/moderation?${params.toString()}`, 303);
      }
      catch (error) {
        errorMessage = displayApiError(error);
      }
    }
  }
  else if (intent === "ticket-update") {
    const ticketId = String(form.get("ticketId") ?? "").trim();
    const nextStatus = normalizeOption(String(form.get("nextStatus") ?? ""), statusOptions);
    const reply = String(form.get("reply") ?? "").trim();

    if (!ticketId) {
      errorMessage = "Selectionnez un ticket support avant de repondre.";
    }
    else if (!nextStatus && !reply) {
      errorMessage = "Indiquez un statut ou une reponse.";
    }
    else {
      try {
        await updateSupportTicket(
          ticketId,
          {
            status: nextStatus || null,
            reply: reply || null
          },
          session.accessToken
        );
        const params = new URLSearchParams();
        params.set("tab", "tickets");
        if (category) params.set("category", category);
        if (priority) params.set("priority", priority);
        if (status) params.set("status", status);
        if (page > 0) params.set("page", String(page));
        params.set("ticketId", ticketId);
        params.set("ticket", "success");
        return Astro.redirect(`/moderation?${params.toString()}`, 303);
      }
      catch (error) {
        errorMessage = displayApiError(error);
      }
    }
  }
  else {
    errorMessage = "Demande de moderation non reconnue.";
  }
}

let ratingItems: ModerationQueueItem[] = [];
let ratingHasMore = false;
let tickets: SupportTicketSummary[] = [];
let ticketsHasMore = false;
let ticketDetail: SupportTicketDetail | null = null;

if (tab === "ratings") {
  try {
    const response = await listModerationQueue(session.accessToken, {
      type: "RATING",
      page,
      size: 20
    });
    ratingItems = response.items;
    ratingHasMore = response.hasMore;
  }
  catch (error) {
    errorMessage ||= displayApiError(error);
  }
}
else {
  try {
    const response = await listSupportTickets(session.accessToken, {
      category: category || undefined,
      priority: priority || undefined,
      status: status || undefined,
      page,
      size: 20
    });
    tickets = response.tickets;
    ticketsHasMore = response.hasMore;
  }
  catch (error) {
    errorMessage ||= displayApiError(error);
  }

  if (!selectedTicketId && tickets.length > 0) {
    selectedTicketId = tickets[0].id;
  }

  if (selectedTicketId) {
    try {
      ticketDetail = await getSupportTicket(selectedTicketId, session.accessToken);
    }
    catch (error) {
      errorMessage ||= displayApiError(error);
    }
  }
}

function displayApiError(error: unknown): string {
  if (error instanceof AdminApiError) {
    return error.correlationId ? `${error.message} Reference: ${error.correlationId}` : error.message;
  }
  return "Le service de moderation est indisponible. Veuillez reessayer.";
}

function formatDate(value: string | null | undefined): string {
  if (!value) return "-";
  return new Intl.DateTimeFormat("fr-CM", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
}

function labelOf(map: Record<string, string>, value: string | null | undefined): string {
  if (!value) return "-";
  return map[value] ?? value;
}

function tabHref(target: ModerationTab): string {
  const params = new URLSearchParams();
  params.set("tab", target);
  if (target === "tickets") {
    if (category) params.set("category", category);
    if (priority) params.set("priority", priority);
    if (status) params.set("status", status);
    if (selectedTicketId) params.set("ticketId", selectedTicketId);
  }
  return `/moderation?${params.toString()}`;
}

function ratingsPageHref(targetPage: number): string {
  const params = new URLSearchParams();
  params.set("tab", "ratings");
  if (targetPage > 0) params.set("page", String(targetPage));
  return `/moderation?${params.toString()}`;
}

function ticketsPageHref(targetPage: number): string {
  const params = new URLSearchParams();
  params.set("tab", "tickets");
  if (category) params.set("category", category);
  if (priority) params.set("priority", priority);
  if (status) params.set("status", status);
  if (selectedTicketId) params.set("ticketId", selectedTicketId);
  if (targetPage > 0) params.set("page", String(targetPage));
  return `/moderation?${params.toString()}`;
}

function ticketHref(ticketId: string): string {
  const params = new URLSearchParams();
  params.set("tab", "tickets");
  if (category) params.set("category", category);
  if (priority) params.set("priority", priority);
  if (status) params.set("status", status);
  if (page > 0) params.set("page", String(page));
  params.set("ticketId", ticketId);
  return `/moderation?${params.toString()}`;
}

function actionButtonClass(tone: "default" | "danger" | "brand"): string {
  if (tone === "danger") {
    return "rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-900 hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-50";
  }
  if (tone === "brand") {
    return "rounded-md bg-brand-700 px-3 py-2 text-sm font-semibold text-white hover:bg-brand-900 disabled:cursor-not-allowed disabled:opacity-50";
  }
  return "rounded-md border border-line px-3 py-2 text-sm font-medium hover:bg-surface disabled:cursor-not-allowed disabled:opacity-50";
}
---

<AdminLayout title="Moderation avis/support" eyebrow="Confiance">
  <section class="space-y-5">
    {
      errorMessage && (
        <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">
          {errorMessage}
        </div>
      )
    }
    {
      successMessage && (
        <div class="rounded-md border border-brand-100 bg-brand-50 px-4 py-3 text-sm text-brand-900" role="status">
          {successMessage}
        </div>
      )
    }

    <div class="flex flex-wrap gap-2 border-b border-line pb-4">
      <a
        href={tabHref("ratings")}
        class:list={[
          "rounded-md px-4 py-2 text-sm font-semibold",
          tab === "ratings" ? "bg-brand-700 text-white" : "border border-line bg-white hover:bg-surface"
        ]}
      >
        Avis signales
      </a>
      <a
        href={tabHref("tickets")}
        class:list={[
          "rounded-md px-4 py-2 text-sm font-semibold",
          tab === "tickets" ? "bg-brand-700 text-white" : "border border-line bg-white hover:bg-surface"
        ]}
      >
        Tickets support
      </a>
    </div>

    {
      tab === "ratings" ? (
        <section class="rounded-lg border border-line bg-white shadow-panel">
          <div class="border-b border-line px-5 py-4">
            <h3 class="font-semibold">Avis signales</h3>
            <p class="text-sm text-muted">{ratingItems.length} avis sur cette page.</p>
          </div>
          <div class="divide-y divide-line">
            {
              ratingItems.length === 0 ? (
                <p class="px-5 py-6 text-sm text-muted">Aucun avis signale dans la file.</p>
              ) : (
                ratingItems.map((item) => (
                  <article class="grid gap-4 px-5 py-4 lg:grid-cols-[1fr_auto] lg:items-start">
                    <div>
                      <div class="flex flex-wrap items-center gap-2">
                        <p class="font-semibold font-mono text-xs">{item.targetId.slice(0, 8)}…</p>
                        <span class="rounded-full bg-surface px-2 py-1 text-xs font-semibold text-muted">
                          {labelOf(priorityLabels, item.priority)}
                        </span>
                        <span class="rounded-full bg-surface px-2 py-1 text-xs text-muted">
                          {labelOf(statusLabels, item.reason)}
                        </span>
                      </div>
                      <p class="mt-2 text-sm">{item.preview || "Sans commentaire"}</p>
                      <p class="mt-2 text-sm text-muted">Signale le {formatDate(item.createdAt)}</p>
                    </div>
                    <div>
                      {
                        !canWrite ? (
                          <p class="rounded-md border border-line bg-surface px-3 py-2 text-sm text-muted">
                            Permission MODERATION_WRITE requise.
                          </p>
                        ) : (
                          <form method="post" class="space-y-3">
                            <input type="hidden" name="intent" value="moderation-action" />
                            <input type="hidden" name="tab" value="ratings" />
                            <input type="hidden" name="page" value={String(page)} />
                            <input type="hidden" name="targetId" value={item.targetId} />
                            <div>
                              <label for={`reason-${item.targetId}`} class="block text-xs font-medium text-ink">
                                Motif (optionnel)
                              </label>
                              <input
                                id={`reason-${item.targetId}`}
                                name="reason"
                                class="mt-1 w-full rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
                                placeholder="Precision pour la moderation"
                              />
                            </div>
                            <div class="flex flex-wrap gap-2">
                              {
                                ratingActions.map((entry) => (
                                  <button
                                    type="submit"
                                    name="action"
                                    value={entry.action}
                                    class={actionButtonClass(entry.tone)}
                                  >
                                    {entry.label}
                                  </button>
                                ))
                              }
                            </div>
                          </form>
                        )
                      }
                    </div>
                  </article>
                ))
              )
            }
          </div>
          <div class="flex items-center justify-between border-t border-line px-5 py-3 text-sm">
            {
              page > 0 ? (
                <a href={ratingsPageHref(page - 1)} class="font-medium text-brand-700 hover:underline">Precedent</a>
              ) : (
                <span class="text-muted">Precedent</span>
              )
            }
            <span class="text-muted">Page {page + 1}</span>
            {
              ratingHasMore ? (
                <a href={ratingsPageHref(page + 1)} class="font-medium text-brand-700 hover:underline">Suivant</a>
              ) : (
                <span class="text-muted">Suivant</span>
              )
            }
          </div>
        </section>
      ) : (
        <>
          <form method="get" action="/moderation" class="flex flex-wrap items-end gap-3 border-b border-line pb-5">
            <input type="hidden" name="tab" value="tickets" />
            <div>
              <label for="category" class="block text-sm font-medium text-ink">Categorie</label>
              <select
                id="category"
                name="category"
                class="mt-2 rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
              >
                {
                  categoryOptions.map((option) => (
                    <option value={option} selected={category === option}>
                      {option ? labelOf(categoryLabels, option) : "Toutes"}
                    </option>
                  ))
                }
              </select>
            </div>
            <div>
              <label for="priority" class="block text-sm font-medium text-ink">Priorite</label>
              <select
                id="priority"
                name="priority"
                class="mt-2 rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
              >
                {
                  priorityOptions.map((option) => (
                    <option value={option} selected={priority === option}>
                      {option ? labelOf(priorityLabels, option) : "Toutes"}
                    </option>
                  ))
                }
              </select>
            </div>
            <div>
              <label for="status" class="block text-sm font-medium text-ink">Statut</label>
              <select
                id="status"
                name="status"
                class="mt-2 rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
              >
                {
                  statusOptions.map((option) => (
                    <option value={option} selected={status === option}>
                      {option ? labelOf(statusLabels, option) : "Tous"}
                    </option>
                  ))
                }
              </select>
            </div>
            <button type="submit" class="rounded-md bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-900">
              Filtrer
            </button>
          </form>

          <div class="grid gap-5 xl:grid-cols-[360px_minmax(0,1fr)]">
            <section class="rounded-lg border border-line bg-white shadow-panel">
              <div class="border-b border-line px-5 py-4">
                <h3 class="font-semibold">Tickets</h3>
                <p class="text-sm text-muted">{tickets.length} ticket(s) sur cette page.</p>
              </div>
              <div class="divide-y divide-line">
                {
                  tickets.length === 0 ? (
                    <p class="px-5 py-6 text-sm text-muted">Aucun ticket ne correspond aux filtres.</p>
                  ) : (
                    tickets.map((ticket) => (
                      <a
                        href={ticketHref(ticket.id)}
                        class:list={[
                          "block px-5 py-4 hover:bg-surface",
                          ticket.id === selectedTicketId ? "bg-brand-50" : "bg-white"
                        ]}
                      >
                        <div class="flex items-start justify-between gap-3">
                          <div>
                            <p class="font-semibold">{ticket.ticketNumber}</p>
                            <p class="text-sm text-muted">
                              {labelOf(categoryLabels, ticket.category)} - {labelOf(statusLabels, ticket.status)}
                            </p>
                          </div>
                          <span class="rounded-full bg-surface px-2 py-1 text-xs font-semibold text-muted">
                            {labelOf(priorityLabels, ticket.priority)}
                          </span>
                        </div>
                        <p class="mt-3 text-sm">{ticket.subject}</p>
                        <p class="mt-1 text-xs text-muted">{formatDate(ticket.createdAt)}</p>
                      </a>
                    ))
                  )
                }
              </div>
              <div class="flex items-center justify-between border-t border-line px-5 py-3 text-sm">
                {
                  page > 0 ? (
                    <a href={ticketsPageHref(page - 1)} class="font-medium text-brand-700 hover:underline">Precedent</a>
                  ) : (
                    <span class="text-muted">Precedent</span>
                  )
                }
                <span class="text-muted">Page {page + 1}</span>
                {
                  ticketsHasMore ? (
                    <a href={ticketsPageHref(page + 1)} class="font-medium text-brand-700 hover:underline">Suivant</a>
                  ) : (
                    <span class="text-muted">Suivant</span>
                  )
                }
              </div>
            </section>

            <section class="rounded-lg border border-line bg-white shadow-panel">
              {
                !ticketDetail ? (
                  <div class="px-5 py-10 text-sm text-muted">Selectionnez un ticket pour afficher le detail.</div>
                ) : (
                  <>
                    <div class="border-b border-line px-5 py-4">
                      <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                          <h3 class="font-semibold">{ticketDetail.ticketNumber}</h3>
                          <p class="text-sm text-muted">{ticketDetail.subject}</p>
                        </div>
                        <div class="flex flex-wrap gap-2">
                          <span class="rounded-full bg-surface px-3 py-1 text-sm text-muted">
                            {labelOf(categoryLabels, ticketDetail.category)}
                          </span>
                          <span class="rounded-full bg-surface px-3 py-1 text-sm text-muted">
                            {labelOf(priorityLabels, ticketDetail.priority)}
                          </span>
                          <span class="rounded-full bg-surface px-3 py-1 text-sm text-muted">
                            {labelOf(statusLabels, ticketDetail.status)}
                          </span>
                        </div>
                      </div>
                    </div>

                    <div class="space-y-4 border-b border-line px-5 py-4 text-sm">
                      <div>
                        <p class="font-medium text-ink">Message initial</p>
                        <p class="mt-2 whitespace-pre-wrap text-muted">{ticketDetail.message}</p>
                      </div>
                      <div class="grid gap-2 text-muted sm:grid-cols-2">
                        <p>Cree le {formatDate(ticketDetail.createdAt)}</p>
                        <p>Clos le {formatDate(ticketDetail.closedAt)}</p>
                        <p>Reservation: {ticketDetail.bookingId ? `${ticketDetail.bookingId.slice(0, 8)}…` : "-"}</p>
                        <p>Paiement: {ticketDetail.paymentTransactionId ? `${ticketDetail.paymentTransactionId.slice(0, 8)}…` : "-"}</p>
                      </div>
                    </div>

                    <div class="border-b border-line px-5 py-4">
                      <h4 class="font-semibold">Conversation</h4>
                      <div class="mt-3 divide-y divide-line rounded-md border border-line">
                        {
                          ticketDetail.messages.length === 0 ? (
                            <p class="px-4 py-4 text-sm text-muted">Aucun message.</p>
                          ) : (
                            ticketDetail.messages.map((message) => (
                              <div class="px-4 py-3 text-sm">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                  <span class="font-medium">
                                    {message.authorAdminProfileId ? "Support" : "Utilisateur"}
                                  </span>
                                  <span class="text-muted">{formatDate(message.createdAt)}</span>
                                </div>
                                <p class="mt-2 whitespace-pre-wrap">{message.body}</p>
                              </div>
                            ))
                          )
                        }
                      </div>
                    </div>

                    <div class="p-5">
                      <h4 class="font-semibold">Reponse / statut</h4>
                      {
                        !canWrite ? (
                          <p class="mt-3 rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
                            Votre session ne contient pas la permission MODERATION_WRITE.
                          </p>
                        ) : (
                          <form method="post" class="mt-3 space-y-4">
                            <input type="hidden" name="intent" value="ticket-update" />
                            <input type="hidden" name="tab" value="tickets" />
                            <input type="hidden" name="ticketId" value={ticketDetail.id} />
                            <input type="hidden" name="category" value={category} />
                            <input type="hidden" name="priority" value={priority} />
                            <input type="hidden" name="status" value={status} />
                            <input type="hidden" name="page" value={String(page)} />
                            <div>
                              <label for="nextStatus" class="block text-sm font-medium text-ink">Nouveau statut</label>
                              <select
                                id="nextStatus"
                                name="nextStatus"
                                class="mt-2 w-full rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
                              >
                                <option value="" selected>
                                  Conserver ({labelOf(statusLabels, ticketDetail.status)})
                                </option>
                                {
                                  statusOptions.filter(Boolean).map((option) => (
                                    <option value={option}>{labelOf(statusLabels, option)}</option>
                                  ))
                                }
                              </select>
                            </div>
                            <div>
                              <label for="reply" class="block text-sm font-medium text-ink">Reponse</label>
                              <textarea
                                id="reply"
                                name="reply"
                                rows="5"
                                class="mt-2 w-full rounded-md border border-line px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
                                placeholder="Message visible par l'utilisateur"
                              ></textarea>
                            </div>
                            <button
                              type="submit"
                              class="rounded-md bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-900"
                            >
                              Enregistrer
                            </button>
                          </form>
                        )
                      }
                    </div>
                  </>
                )
              }
            </section>
          </div>
        </>
      )
    }
  </section>
</AdminLayout>
