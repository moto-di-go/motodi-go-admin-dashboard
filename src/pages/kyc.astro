---
import AdminLayout from "../layouts/AdminLayout.astro";
import { AdminApiError } from "../lib/server/api-client";
import {
  decideKycDocument,
  decideKycProfile,
  getKycReviewDocuments,
  listKycReviews
} from "../lib/server/kyc-service";
import {
  canDecideKyc,
  canDecideKycDocument,
  formatFileSize,
  formatKycAge,
  kycProfileTypeOptions,
  kycReviewQuery,
  kycStatusOptions,
  normalizeKycProfileFilter,
  normalizeKycStatusFilter,
  selectedKycUrl,
  validateKycDecisionForm
} from "../lib/kyc/view-model";
import type { AdminKycDocumentBundle, AdminKycQueueItem, KycReviewFilters } from "../lib/kyc/types";

const session = Astro.locals.adminSession;
if (!session) {
  return Astro.redirect("/login", 302);
}

let profileType = normalizeKycProfileFilter(Astro.url.searchParams.get("profileType"));
let status = normalizeKycStatusFilter(Astro.url.searchParams.get("status"));
let selectedProfileId = Astro.url.searchParams.get("profileId") ?? "";
let errorMessage = "";
let successMessage = "";
if (Astro.url.searchParams.get("decision") === "success") {
  successMessage = "Decision KYC enregistree. Le dossier et la file ont ete recharges.";
}
if (Astro.url.searchParams.get("documentDecision") === "success") {
  successMessage = "Decision documentaire enregistree. Le dossier et la file ont ete recharges.";
}
const allowedToDecide = canDecideKyc(session);

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  profileType = normalizeKycProfileFilter(String(form.get("profileType") ?? ""));
  status = normalizeKycStatusFilter(String(form.get("status") ?? ""));
  selectedProfileId = String(form.get("profileId") ?? "").trim();
  const documentId = String(form.get("documentId") ?? "").trim();
  const validation = validateKycDecisionForm({
    decision: String(form.get("decision") ?? ""),
    reason: String(form.get("reason") ?? ""),
    allowed: allowedToDecide
  });

  if (!selectedProfileId) {
    errorMessage = "Selectionnez un dossier KYC avant de prendre une decision.";
  }
  else if (documentId === "" && String(form.get("scope") ?? "") === "document") {
    errorMessage = "Selectionnez un document KYC avant de prendre une decision.";
  }
  else if (!validation.ok) {
    errorMessage = validation.message;
  }
  else {
    try {
      if (documentId) {
        await decideKycDocument(
          documentId,
          { decision: validation.decision, reason: validation.reason },
          session.accessToken
        );
      }
      else {
        await decideKycProfile(
          selectedProfileId,
          { decision: validation.decision, reason: validation.reason },
          session.accessToken
        );
      }
      const params = new URLSearchParams(kycReviewQuery({ profileType, status }));
      params.set("profileId", selectedProfileId);
      params.set(documentId ? "documentDecision" : "decision", "success");
      return Astro.redirect(`/kyc?${params.toString()}`, 303);
    }
    catch (error) {
      errorMessage = displayApiError(error);
    }
  }
}

const filters: KycReviewFilters = { profileType, status };
let queue: AdminKycQueueItem[] = [];
let detail: AdminKycDocumentBundle | null = null;

try {
  queue = await listKycReviews(filters, session.accessToken);
}
catch (error) {
  errorMessage ||= displayApiError(error);
}

if (!selectedProfileId && queue.length > 0) {
  selectedProfileId = queue[0].profileId;
}

if (selectedProfileId) {
  try {
    detail = await getKycReviewDocuments(selectedProfileId, session.accessToken);
  }
  catch (error) {
    errorMessage ||= displayApiError(error);
  }
}

const canDecideSelected = allowedToDecide && detail?.profileValidationStatus === "PENDING";

const profileLabels = {
  PASSENGER: "Passager",
  MOTOTAXI: "Mototaxi",
  TRANSPORTER: "Transporteur"
};
const statusLabels = {
  DRAFT: "Brouillon",
  PENDING: "En attente",
  VALIDATED: "Valide",
  REJECTED: "Rejete",
  SUSPENDED: "Suspendu"
};
const documentLabels: Record<string, string> = {
  CNI: "CNI",
  DRIVER_LICENSE: "Permis",
  VEHICLE_REGISTRATION: "Carte grise",
  INSURANCE: "Assurance",
  PROFILE_PHOTO: "Photo profil",
  AGENCY_DOCUMENT: "Document agence",
  VEHICLE_PHOTO: "Photo du véhicule"
};

function documentLabel(type: string | null | undefined): string {
  if (!type) return "Document";
  return documentLabels[type] ?? type;
}
const documentStatusLabels = {
  UPLOADED: "Televerse",
  ENCRYPTED: "Chiffre",
  PENDING_REVIEW: "A examiner",
  ACCEPTED: "Accepte",
  REJECTED: "Rejete",
  EXPIRED: "Expire"
};
const decisionLabels = {
  VALIDATE: "Validation",
  REJECT: "Rejet",
  SUSPEND: "Suspension"
};

function displayApiError(error: unknown): string {
  if (error instanceof AdminApiError) {
    return error.correlationId ? `${error.message} Reference: ${error.correlationId}` : error.message;
  }
  return "Le service KYC est indisponible. Veuillez reessayer.";
}

function formatDate(value: string | null | undefined): string {
  if (!value) {
    return "-";
  }
  return new Intl.DateTimeFormat("fr-CM", {
    dateStyle: "medium",
    timeStyle: "short"
  }).format(new Date(value));
}
---

<AdminLayout title="Validation KYC" eyebrow="Confiance">
  <section class="space-y-5">
    {
      errorMessage && (
        <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">
          {errorMessage}
        </div>
      )
    }
    {
      successMessage && (
        <div class="rounded-md border border-brand-100 bg-brand-50 px-4 py-3 text-sm text-brand-900" role="status">
          {successMessage}
        </div>
      )
    }

    <form method="get" action="/kyc" class="border-b border-line pb-5">
      <div class="flex flex-wrap items-end gap-3">
        <div>
          <label for="profileType" class="block text-sm font-medium text-ink">Profil</label>
          <select
            id="profileType"
            name="profileType"
            class="mt-2 rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
          >
            <option value="" selected={!profileType}>Tous profils</option>
            {
              kycProfileTypeOptions.map((option) => (
                <option value={option} selected={profileType === option}>{profileLabels[option]}</option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="status" class="block text-sm font-medium text-ink">Statut</label>
          <select
            id="status"
            name="status"
            class="mt-2 rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
          >
            {
              kycStatusOptions.map((option) => (
                <option value={option} selected={status === option}>{statusLabels[option]}</option>
              ))
            }
          </select>
        </div>
        <button
          type="submit"
          class="rounded-md bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-900"
        >
          Filtrer
        </button>
      </div>
    </form>

    <div class="grid gap-5 xl:grid-cols-[360px_minmax(0,1fr)]">
      <section class="rounded-lg border border-line bg-white shadow-panel">
        <div class="border-b border-line px-5 py-4">
          <h3 class="font-semibold">Dossiers</h3>
          <p class="text-sm text-muted">{queue.length} dossier(s) pour les filtres actifs.</p>
        </div>
        <div class="divide-y divide-line">
          {
            queue.length === 0 ? (
              <p class="px-5 py-6 text-sm text-muted">Aucun dossier KYC ne correspond aux filtres.</p>
            ) : (
              queue.map((item) => (
                <a
                  href={selectedKycUrl(filters, item.profileId)}
                  class:list={[
                    "block px-5 py-4 hover:bg-surface",
                    item.profileId === selectedProfileId ? "bg-brand-50" : "bg-white"
                  ]}
                >
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <p class="font-semibold">{item.displayName}</p>
                      <p class="text-sm text-muted">{profileLabels[item.profileType]} - {statusLabels[item.profileValidationStatus]}</p>
                    </div>
                    <span class="rounded-full bg-surface px-2 py-1 text-xs text-muted">
                      {formatKycAge(item.oldestPendingDocumentAt)}
                    </span>
                  </div>
                  <p class="mt-3 text-sm">
                    {item.pendingDocumentsCount} en attente / {item.documentsCount} document(s)
                  </p>
                </a>
              ))
            )
          }
        </div>
      </section>

      <section class="rounded-lg border border-line bg-white shadow-panel">
        {
          !detail ? (
            <div class="px-5 py-10 text-sm text-muted">Selectionnez un dossier pour examiner ses documents.</div>
          ) : (
            <>
              <div class="border-b border-line px-5 py-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h3 class="font-semibold">{detail.displayName}</h3>
                    <p class="text-sm text-muted">
                      {profileLabels[detail.profileType]} - {statusLabels[detail.profileValidationStatus]}
                    </p>
                  </div>
                  <span class="rounded-full bg-surface px-3 py-1 text-sm text-muted">
                    {detail.documents.length} document(s)
                  </span>
                </div>
              </div>

              <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-line text-left text-sm">
                  <thead class="bg-surface text-xs uppercase text-muted">
                    <tr>
                      <th class="px-5 py-3 font-semibold">Document</th>
                      <th class="px-5 py-3 font-semibold">Vehicule</th>
                      <th class="px-5 py-3 font-semibold">Statut</th>
                      <th class="px-5 py-3 font-semibold">Fichier</th>
                      <th class="px-5 py-3 font-semibold">Depot</th>
                      <th class="px-5 py-3 font-semibold">Motif</th>
                      <th class="px-5 py-3 font-semibold">Acces</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-line">
                    {
                      detail.documents.map((document) => (
                        <tr>
                          <td class="px-5 py-3 font-medium">{documentLabel(document.type)}</td>
                          <td class="px-5 py-3 text-muted text-xs font-mono">
                            {document.vehicleId ? document.vehicleId.slice(0, 8) + "…" : "-"}
                          </td>
                          <td class="px-5 py-3">{documentStatusLabels[document.status]}</td>
                          <td class="px-5 py-3 text-muted">
                            <span class="block max-w-[220px] truncate">{document.fileName ?? document.id}</span>
                            <span class="text-xs">{document.mimeType} - {formatFileSize(document.sizeBytes)}</span>
                          </td>
                          <td class="px-5 py-3 text-muted">{formatDate(document.uploadedAt)}</td>
                          <td class="px-5 py-3 text-muted">{document.rejectionReason ?? "-"}</td>
                          <td class="px-5 py-3">
                            <button
                              type="button"
                              data-open-document={document.id}
                              class="rounded-md border border-line px-3 py-2 text-sm font-medium hover:bg-surface"
                            >
                              Examiner
                            </button>
                          </td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>

              <div>
                {
                  detail.documents.map((document) => {
                    const documentActionAllowed = canDecideKycDocument({
                      session,
                      profileStatus: detail.profileValidationStatus,
                      document
                    });
                    const previewUrl = `/api/kyc/documents/${document.id}/content`;
                    const isImage = document.mimeType.startsWith("image/");
                    const isPdf = document.mimeType === "application/pdf";
                    return (
                      <dialog
                        id={`document-dialog-${document.id}`}
                        class="w-[min(960px,calc(100vw-2rem))] rounded-lg border border-line bg-white p-0 shadow-panel backdrop:bg-ink/40"
                      >
                        <div class="border-b border-line px-5 py-4">
                          <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                              <h4 class="font-semibold">{documentLabel(document.type)}</h4>
                              <p class="text-sm text-muted">
                                {document.fileName ?? document.id} - {documentStatusLabels[document.status]}
                              </p>
                            </div>
                            <form method="dialog">
                              <button
                                type="submit"
                                class="rounded-md border border-line px-3 py-2 text-sm font-medium hover:bg-surface"
                              >
                                Fermer
                              </button>
                            </form>
                          </div>
                        </div>
                        <div class="grid gap-5 p-5 lg:grid-cols-[minmax(0,1fr)_320px]">
                          <div class="min-h-[420px] overflow-hidden rounded-md border border-line bg-surface">
                            {
                              isImage ? (
                                <img
                                  src={previewUrl}
                                  alt={`Document ${documentLabel(document.type)}`}
                                  class="h-full max-h-[70vh] w-full object-contain"
                                />
                              ) : isPdf ? (
                                <iframe
                                  src={previewUrl}
                                  title={`Document ${documentLabel(document.type)}`}
                                  class="h-[70vh] w-full"
                                />
                              ) : (
                                <div class="flex h-[420px] items-center justify-center p-6 text-center text-sm text-muted">
                                  Apercu indisponible pour ce format. Ouvrez le document via le proxy securise.
                                </div>
                              )
                            }
                          </div>
                          <aside class="space-y-4">
                            <div class="rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
                              <p>Type: {documentLabel(document.type)}</p>
                              <p>Statut: {documentStatusLabels[document.status]}</p>
                              <p>Vehicule: {document.vehicleId ?? "-"}</p>
                              <p>Taille: {formatFileSize(document.sizeBytes)}</p>
                              <p>Depot: {formatDate(document.uploadedAt)}</p>
                            </div>
                            {
                              !documentActionAllowed ? (
                                <p class="rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
                                  Action disponible uniquement sur un document en attente avec KYC_DECIDE.
                                </p>
                              ) : (
                                <div class="space-y-4">
                                  <form method="post">
                                    <input type="hidden" name="scope" value="document" />
                                    <input type="hidden" name="profileId" value={detail.profileId} />
                                    <input type="hidden" name="documentId" value={document.id} />
                                    <input type="hidden" name="profileType" value={profileType ?? ""} />
                                    <input type="hidden" name="status" value={status} />
                                    <button
                                      type="submit"
                                      name="decision"
                                      value="VALIDATE"
                                      class="w-full rounded-md bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-900"
                                    >
                                      Valider ce document
                                    </button>
                                  </form>
                                  <form method="post" class="space-y-3">
                                    <input type="hidden" name="scope" value="document" />
                                    <input type="hidden" name="profileId" value={detail.profileId} />
                                    <input type="hidden" name="documentId" value={document.id} />
                                    <input type="hidden" name="profileType" value={profileType ?? ""} />
                                    <input type="hidden" name="status" value={status} />
                                    <label for={`document-reason-${document.id}`} class="block text-sm font-medium text-ink">
                                      Motif de rejet
                                    </label>
                                    <textarea
                                      id={`document-reason-${document.id}`}
                                      name="reason"
                                      required
                                      rows="4"
                                      class="w-full rounded-md border border-line px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
                                    ></textarea>
                                    <button
                                      type="submit"
                                      name="decision"
                                      value="REJECT"
                                      class="w-full rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm font-semibold text-red-900 hover:bg-red-100"
                                    >
                                      Rejeter ce document
                                    </button>
                                  </form>
                                </div>
                              )
                            }
                          </aside>
                        </div>
                      </dialog>
                    );
                  })
                }
              </div>

              <div class="grid gap-5 border-t border-line p-5 lg:grid-cols-[minmax(0,1fr)_320px]">
                <section>
                  <h4 class="font-semibold">Historique decisions</h4>
                  <div class="mt-3 divide-y divide-line rounded-md border border-line">
                    {
                      detail.decisions.length === 0 && detail.documentDecisions.length === 0 ? (
                        <p class="px-4 py-4 text-sm text-muted">Aucune decision enregistree.</p>
                      ) : (
                        detail.decisions.map((decision) => (
                          <div class="px-4 py-3 text-sm">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                              <span class="font-medium">{decisionLabels[decision.decision]}</span>
                              <span class="text-muted">{formatDate(decision.decidedAt)}</span>
                            </div>
                            <p class="mt-1 text-muted">Admin: {decision.adminProfileId ?? "non renseigne"}</p>
                            {decision.reason && <p class="mt-1">{decision.reason}</p>}
                          </div>
                        ))
                      )
                    }
                    {
                      detail.documentDecisions.map((decision) => (
                        <div class="px-4 py-3 text-sm">
                          <div class="flex flex-wrap items-center justify-between gap-2">
                            <span class="font-medium">
                              Document {documentLabel(decision.documentType)} - {decisionLabels[decision.decision]}
                            </span>
                            <span class="text-muted">{formatDate(decision.decidedAt)}</span>
                          </div>
                          <p class="mt-1 text-muted">
                            Admin: {decision.adminProfileId ?? "non renseigne"} - {decision.fileName ?? decision.documentId ?? "document supprime"}
                          </p>
                          {decision.reason && <p class="mt-1">{decision.reason}</p>}
                        </div>
                      ))
                    }
                  </div>
                </section>

                <aside>
                  <h4 class="font-semibold">Decision</h4>
                  {
                    !allowedToDecide ? (
                      <p class="mt-3 rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
                        Votre session ne contient pas la permission KYC_DECIDE.
                      </p>
                    ) : !canDecideSelected ? (
                      <p class="mt-3 rounded-md border border-line bg-surface px-4 py-3 text-sm text-muted">
                        Une decision est possible uniquement sur un profil en attente.
                      </p>
                    ) : (
                      <div class="mt-3 space-y-4">
                        <form method="post">
                          <input type="hidden" name="profileId" value={detail.profileId} />
                          <input type="hidden" name="profileType" value={profileType ?? ""} />
                          <input type="hidden" name="status" value={status} />
                          <button
                            type="submit"
                            name="decision"
                            value="VALIDATE"
                            class="w-full rounded-md bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-900"
                          >
                            Valider le profil
                          </button>
                        </form>
                        <form method="post" class="space-y-3">
                          <input type="hidden" name="profileId" value={detail.profileId} />
                          <input type="hidden" name="profileType" value={profileType ?? ""} />
                          <input type="hidden" name="status" value={status} />
                          <label for="reason" class="block text-sm font-medium text-ink">Motif de rejet</label>
                          <textarea
                            id="reason"
                            name="reason"
                            required
                            rows="4"
                            class="w-full rounded-md border border-line px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
                          ></textarea>
                          <button
                            type="submit"
                            name="decision"
                            value="REJECT"
                            class="w-full rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm font-semibold text-red-900 hover:bg-red-100"
                          >
                            Rejeter le profil
                          </button>
                        </form>
                      </div>
                    )
                  }
                </aside>
              </div>
            </>
          )
        }
      </section>
    </div>
  </section>

  <script>
    document.querySelectorAll("[data-open-document]").forEach((button) => {
      button.addEventListener("click", () => {
        const documentId = button.getAttribute("data-open-document");
        if (!documentId) return;
        const dialog = document.getElementById(`document-dialog-${documentId}`);
        if (dialog instanceof HTMLDialogElement) {
          dialog.showModal();
        }
      });
    });
  </script>
</AdminLayout>
