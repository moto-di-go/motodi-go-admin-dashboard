---
import AdminLayout from "../layouts/AdminLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { AdminApiError } from "../lib/server/api-client";
import { listOpsAnnouncements, opsExportPath } from "../lib/server/ops-service";
import type { OpsAnnouncementSummary } from "../lib/ops/types";

const session = Astro.locals.adminSession;
if (!session) {
  return Astro.redirect("/login", 302);
}

const status = Astro.url.searchParams.get("status") ?? "";
const search = Astro.url.searchParams.get("search") ?? "";
const page = Math.max(Number(Astro.url.searchParams.get("page") ?? "0") || 0, 0);

let announcements: OpsAnnouncementSummary[] = [];
let hasMore = false;
let errorMessage = "";

try {
  const response = await listOpsAnnouncements(session.accessToken, { status, search, page, size: 20 });
  announcements = response.announcements;
  hasMore = response.hasMore;
}
catch (error) {
  errorMessage = error instanceof AdminApiError ? error.message : "Impossible de charger les annonces.";
}

const exportHref = opsExportPath("announcements", { status: status || undefined, search: search || undefined });
const statusOptions = ["", "DRAFT", "PUBLISHED", "FULL", "CLOSED", "CANCELLED"];

function formatDate(value: string | null | undefined): string {
  if (!value) return "-";
  return new Intl.DateTimeFormat("fr-CM", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
}

function pageHref(targetPage: number): string {
  const params = new URLSearchParams();
  if (status) params.set("status", status);
  if (search) params.set("search", search);
  if (targetPage > 0) params.set("page", String(targetPage));
  return `/announcements?${params.toString()}`;
}
---

<AdminLayout title="Annonces" eyebrow="Pilotage">
  {
    errorMessage && (
      <p class="alert-danger" role="alert">{errorMessage}</p>
    )
  }

  <form method="get" action="/announcements" class="filter-bar">
    <div>
      <label for="search" class="field-label">Recherche</label>
      <input
        id="search"
        name="search"
        value={search}
        placeholder="Ville, id"
        class="field-control"
      />
    </div>
    <div>
      <label for="status" class="field-label">Statut</label>
      <select id="status" name="status" class="field-control">
        {
          statusOptions.map((option) => (
            <option value={option} selected={status === option}>
              {option || "Tous"}
            </option>
          ))
        }
      </select>
    </div>
    <button type="submit" class="btn-primary">Filtrer</button>
    <a href={exportHref} class="btn-secondary">Export CSV</a>
  </form>

  <section class="panel overflow-hidden">
    <div class="border-b border-line px-5 py-4">
      <h3 class="font-display font-semibold">Annonces interurbaines</h3>
      <p class="text-sm text-muted">{announcements.length} annonce(s) sur cette page.</p>
    </div>
    <div class="overflow-x-auto">
      <table class="data-table min-w-[720px]">
        <thead>
          <tr>
            <th>Trajet</th>
            <th>Depart</th>
            <th class="text-right">Prix</th>
            <th class="text-right">Places</th>
            <th>Statut</th>
            <th>Cree</th>
          </tr>
        </thead>
        <tbody>
          {
            announcements.length === 0 ? (
              <tr>
                <td class="empty-state" colspan="6">Aucune annonce.</td>
              </tr>
            ) : (
              announcements.map((item) => (
                <tr>
                  <td class="font-medium">
                    {item.departureCity} → {item.destinationCity}
                  </td>
                  <td class="font-data text-xs text-muted">
                    {item.departureDate ?? "-"} {item.departureTime ?? ""}
                  </td>
                  <td class="num">{item.priceFcfa} FCFA</td>
                  <td class="num">
                    {item.remainingSeats}/{item.totalSeats}
                  </td>
                  <td><StatusBadge status={item.status} /></td>
                  <td class="text-muted">{formatDate(item.createdAt)}</td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
    <div class="flex items-center justify-between border-t border-line px-5 py-3 text-sm">
      {
        page > 0 ? (
          <a href={pageHref(page - 1)} class="font-medium text-brand-700 hover:underline">Precedent</a>
        ) : (
          <span class="text-muted">Precedent</span>
        )
      }
      <span class="font-data text-muted">Page {page + 1}</span>
      {
        hasMore ? (
          <a href={pageHref(page + 1)} class="font-medium text-brand-700 hover:underline">Suivant</a>
        ) : (
          <span class="text-muted">Suivant</span>
        )
      }
    </div>
  </section>
</AdminLayout>
