---
import AdminLayout from "../layouts/AdminLayout.astro";
import { AdminApiError } from "../lib/server/api-client";
import {
  getReconcileTransaction,
  listReconcileTransactions,
  type ReconcileTransaction
} from "../lib/server/payment-reconcile-service";

const session = Astro.locals.adminSession;
if (!session) {
  return Astro.redirect("/login", 302);
}

const canReconcile = session.permissions.includes("PAYMENT_RECONCILE_READ");
const provider = Astro.url.searchParams.get("provider") ?? "";
const status = Astro.url.searchParams.get("status") ?? "";
const externalReference = Astro.url.searchParams.get("externalReference") ?? "";
const selectedId = Astro.url.searchParams.get("paymentId") ?? "";
const page = Math.max(Number(Astro.url.searchParams.get("page") ?? "0") || 0, 0);

let transactions: ReconcileTransaction[] = [];
let detail: ReconcileTransaction | null = null;
let hasMore = false;
let errorMessage = "";

if (!canReconcile) {
  errorMessage = "Permission PAYMENT_RECONCILE_READ requise pour la reconciliation.";
}
else {
  try {
    const response = await listReconcileTransactions(session.accessToken, {
      provider,
      status,
      externalReference,
      page,
      size: 20
    });
    transactions = response.transactions;
    hasMore = response.hasMore;
  }
  catch (error) {
    errorMessage = error instanceof AdminApiError ? error.message : "Impossible de charger la reconciliation.";
  }

  if (selectedId) {
    try {
      detail = await getReconcileTransaction(selectedId, session.accessToken);
    }
    catch (error) {
      errorMessage ||= error instanceof AdminApiError ? error.message : "Detail transaction indisponible.";
    }
  }
}

const providerOptions = ["", "MTN_MOMO", "ORANGE_MONEY", "AGGREGATOR"];
const statusOptions = ["", "INITIATED", "PENDING_CALLBACK", "CONFIRMED", "FAILED", "EXPIRED", "REFUNDED"];

function formatDate(value: string | null | undefined): string {
  if (!value) return "-";
  return new Intl.DateTimeFormat("fr-CM", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
}

function formatAmount(value: number, currency: string): string {
  return `${new Intl.NumberFormat("fr-CM").format(Number(value))} ${currency}`;
}

function pageHref(targetPage: number): string {
  const params = new URLSearchParams();
  if (provider) params.set("provider", provider);
  if (status) params.set("status", status);
  if (externalReference) params.set("externalReference", externalReference);
  if (selectedId) params.set("paymentId", selectedId);
  if (targetPage > 0) params.set("page", String(targetPage));
  return `/reconciliation?${params.toString()}`;
}

function detailHref(paymentId: string): string {
  const params = new URLSearchParams();
  if (provider) params.set("provider", provider);
  if (status) params.set("status", status);
  if (externalReference) params.set("externalReference", externalReference);
  if (page > 0) params.set("page", String(page));
  params.set("paymentId", paymentId);
  return `/reconciliation?${params.toString()}`;
}
---

<AdminLayout title="Reconciliation" eyebrow="Pilotage">
  {
    errorMessage && (
      <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">
        {errorMessage}
      </p>
    )
  }

  <p class="mb-4 text-sm text-muted">
    Depots Mobile Money via <code>/api/v1/admin/payments/transactions</code>.
    <a class="ml-2 font-medium text-brand-700 hover:underline" href="/payments">Voir toutes les transactions ops</a>
  </p>

  {
    canReconcile && (
      <form method="get" action="/reconciliation" class="mb-5 flex flex-wrap items-end gap-3 border-b border-line pb-5">
        <div>
          <label for="externalReference" class="block text-sm font-medium text-ink">Reference externe</label>
          <input
            id="externalReference"
            name="externalReference"
            value={externalReference}
            placeholder="ext-..."
            class="mt-2 rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
          />
        </div>
        <div>
          <label for="provider" class="block text-sm font-medium text-ink">Fournisseur</label>
          <select
            id="provider"
            name="provider"
            class="mt-2 rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
          >
            {
              providerOptions.map((option) => (
                <option value={option} selected={provider === option}>
                  {option || "Tous"}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="status" class="block text-sm font-medium text-ink">Statut</label>
          <select
            id="status"
            name="status"
            class="mt-2 rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
          >
            {
              statusOptions.map((option) => (
                <option value={option} selected={status === option}>
                  {option || "Tous"}
                </option>
              ))
            }
          </select>
        </div>
        <button type="submit" class="rounded-md bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-900">
          Filtrer
        </button>
      </form>
    )
  }

  <div class="grid gap-5 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
    <section class="rounded-lg border border-line bg-white shadow-panel">
      <div class="border-b border-line px-5 py-4">
        <h3 class="font-semibold">Depots a reconcilier</h3>
        <p class="text-sm text-muted">{transactions.length} transaction(s) sur cette page.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead class="bg-surface text-xs uppercase text-muted">
            <tr>
              <th class="px-5 py-3">Reference</th>
              <th class="px-5 py-3">Statut</th>
              <th class="px-5 py-3">Montant</th>
              <th class="px-5 py-3">Fournisseur</th>
              <th class="px-5 py-3">Date</th>
            </tr>
          </thead>
          <tbody>
            {
              transactions.length === 0 ? (
                <tr>
                  <td class="px-5 py-4 text-muted" colspan="5">Aucune transaction.</td>
                </tr>
              ) : (
                transactions.map((item) => (
                  <tr class:list={["border-t border-line", selectedId === item.id && "bg-brand-50"]}>
                    <td class="px-5 py-4">
                      <a class="font-medium text-brand-700 hover:underline" href={detailHref(item.id)}>
                        {item.externalReference ?? item.id.slice(0, 8)}
                      </a>
                    </td>
                    <td class="px-5 py-4">{item.status}</td>
                    <td class="px-5 py-4">{formatAmount(item.amount, item.currency)}</td>
                    <td class="px-5 py-4">{item.provider ?? "-"}</td>
                    <td class="px-5 py-4 text-muted">{formatDate(item.initiatedAt)}</td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
      <div class="flex items-center justify-between border-t border-line px-5 py-3 text-sm">
        {
          page > 0 ? (
            <a href={pageHref(page - 1)} class="font-medium text-brand-700 hover:underline">Precedent</a>
          ) : (
            <span class="text-muted">Precedent</span>
          )
        }
        <span class="text-muted">Page {page + 1}</span>
        {
          hasMore ? (
            <a href={pageHref(page + 1)} class="font-medium text-brand-700 hover:underline">Suivant</a>
          ) : (
            <span class="text-muted">Suivant</span>
          )
        }
      </div>
    </section>

    <section class="rounded-lg border border-line bg-white shadow-panel">
      <div class="border-b border-line px-5 py-4">
        <h3 class="font-semibold">Detail</h3>
      </div>
      {
        !detail ? (
          <p class="px-5 py-6 text-sm text-muted">Selectionnez une transaction pour voir le detail.</p>
        ) : (
          <dl class="space-y-3 px-5 py-5 text-sm">
            <div>
              <dt class="text-muted">Reference</dt>
              <dd class="font-medium">{detail.externalReference ?? detail.id}</dd>
            </div>
            <div>
              <dt class="text-muted">Statut</dt>
              <dd class="font-medium">{detail.status}</dd>
            </div>
            <div>
              <dt class="text-muted">Montant</dt>
              <dd class="font-medium">{formatAmount(detail.amount, detail.currency)}</dd>
            </div>
            <div>
              <dt class="text-muted">Fournisseur</dt>
              <dd class="font-medium">{detail.provider ?? "-"}</dd>
            </div>
            <div>
              <dt class="text-muted">Telephone payeur</dt>
              <dd class="font-medium">{detail.payerPhone ?? "-"}</dd>
            </div>
            <div>
              <dt class="text-muted">Initie</dt>
              <dd class="font-medium">{formatDate(detail.initiatedAt)}</dd>
            </div>
            <div>
              <dt class="text-muted">Confirme</dt>
              <dd class="font-medium">{formatDate(detail.confirmedAt)}</dd>
            </div>
            <div>
              <dt class="text-muted">Motif echec</dt>
              <dd class="font-medium">{detail.failureReason ?? "-"}</dd>
            </div>
          </dl>
        )
      }
    </section>
  </div>
</AdminLayout>
