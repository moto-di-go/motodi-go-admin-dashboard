---
import "../styles/global.css";

interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow = "Back-office securise" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Acces admin MOTO'DI GO" />
    <title>{title} - MOTO'DI GO Admin</title>
  </head>
  <body>
    <main class="min-h-screen bg-surface px-4 py-8 text-ink sm:px-6 lg:px-8">
      <div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-md flex-col justify-center">
        <div class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">
            MOTO'DI GO
          </p>
          <h1 class="mt-2 text-3xl font-semibold">{title}</h1>
          <p class="mt-2 text-sm text-muted">{eyebrow}</p>
        </div>
        <slot />
      </div>
    </main>
  </body>
</html>
