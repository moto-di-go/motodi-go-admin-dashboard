---
import "../styles/global.css";
import { config } from "../lib/config";
import { getActiveProfile, normalizePath } from "../lib/auth/rbac";
import { groupNavItems } from "../lib/ui/nav";

interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow = "Back-office" } = Astro.props;
const session = Astro.locals.adminSession;
const navItems = Astro.locals.navigation ?? [];
const navGroups = groupNavItems(navItems);
const activeProfile = session ? getActiveProfile(session) : undefined;
const profileLabel = activeProfile
  ? `${activeProfile.type} · ${activeProfile.validationStatus}`
  : "Session inconnue";
const currentPath = normalizePath(Astro.url.pathname);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Dashboard admin MOTO'DI GO" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Sora:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} - MOTO'DI GO Admin</title>
  </head>
  <body>
    <div class="min-h-screen text-ink">
      <aside
        class="fixed inset-y-0 left-0 z-20 hidden w-64 border-r border-line bg-white/95 px-4 py-6 backdrop-blur-sm lg:block"
      >
        <div class="mb-6 px-1">
          <p class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-brand-700">
            MOTO'DI GO
          </p>
          <h1 class="font-display mt-2 text-lg font-semibold tracking-tight">Pilotage</h1>
          <p class="mt-1 text-xs text-muted">{config.appEnv} · {profileLabel}</p>
        </div>
        <nav class="space-y-0.5 overflow-y-auto pb-8" aria-label="Navigation principale">
          {
            navGroups.map((group) => (
              <div>
                <p class="nav-group-label">{group.label}</p>
                {group.items.map((item) => {
                  const active = currentPath === normalizePath(item.href);
                  return (
                    <a
                      href={item.href}
                      class:list={["nav-link", active ? "nav-link-active" : "nav-link-idle"]}
                      aria-current={active ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  );
                })}
              </div>
            ))
          }
        </nav>
      </aside>

      <div class="lg:pl-64">
        <header class="sticky top-0 z-10 border-b border-line bg-white/90 px-4 py-4 backdrop-blur-sm sm:px-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">
                {eyebrow}
              </p>
              <h2 class="font-display mt-1 text-2xl font-semibold tracking-tight">{title}</h2>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <div class="rounded-md border border-line bg-surface px-3 py-2 font-data text-xs text-muted">
                {session?.phoneNumber ?? "Compte admin"}
              </div>
              <form method="post" action="/api/logout">
                <button type="submit" class="btn-secondary">
                  Deconnexion
                </button>
              </form>
            </div>
          </div>
          <nav class="mt-4 flex gap-2 overflow-x-auto pb-1 lg:hidden" aria-label="Navigation mobile">
            {
              navItems.map((item) => {
                const active = currentPath === normalizePath(item.href);
                return (
                  <a
                    href={item.href}
                    class:list={[
                      "whitespace-nowrap rounded-md border px-3 py-2 text-sm font-medium transition-colors",
                      active
                        ? "border-brand-700 bg-brand-50 text-brand-900"
                        : "border-line bg-white text-muted"
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })
            }
          </nav>
        </header>

        <main class="page-enter px-4 py-6 sm:px-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
