---
import "../styles/global.css";
import { config } from "../lib/config";
import { getActiveProfile, normalizePath } from "../lib/auth/rbac";

interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow = "Back-office" } = Astro.props;
const session = Astro.locals.adminSession;
const navItems = Astro.locals.navigation ?? [];
const activeProfile = session ? getActiveProfile(session) : undefined;
const profileLabel = activeProfile
  ? `${activeProfile.type} - ${activeProfile.validationStatus}`
  : "Session inconnue";
const currentPath = normalizePath(Astro.url.pathname);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Dashboard admin MOTO'DI GO" />
    <title>{title} - MOTO'DI GO Admin</title>
  </head>
  <body>
    <div class="min-h-screen bg-surface text-ink">
      <aside
        class="fixed inset-y-0 left-0 hidden w-64 border-r border-line bg-white px-5 py-6 lg:block"
      >
        <div class="mb-8">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">
            MOTO'DI GO
          </p>
          <h1 class="mt-2 text-xl font-semibold">Admin dashboard</h1>
          <p class="mt-1 text-sm text-muted">{config.appEnv} - {profileLabel}</p>
        </div>
        <nav class="space-y-1">
          {
            navItems.map((item) => {
              const active = currentPath === normalizePath(item.href);
              return (
                <a
                  href={item.href}
                  class:list={[
                    "block rounded-md px-3 py-2 text-sm font-medium",
                    active ? "bg-brand-50 text-brand-900" : "text-muted hover:bg-surface hover:text-ink"
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </aside>

      <div class="lg:pl-64">
        <header class="border-b border-line bg-white px-4 py-4 sm:px-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">
                {eyebrow}
              </p>
              <h2 class="mt-1 text-2xl font-semibold">{title}</h2>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <div class="rounded-md border border-line px-3 py-2 text-sm text-muted">
                {session?.phoneNumber ?? "Compte admin"} - RBAC actif
              </div>
              <form method="post" action="/api/logout">
                <button
                  type="submit"
                  class="rounded-md border border-line bg-white px-3 py-2 text-sm font-medium text-ink hover:bg-surface"
                >
                  Deconnexion
                </button>
              </form>
            </div>
          </div>
          <nav class="mt-4 flex gap-2 overflow-x-auto lg:hidden">
            {
              navItems.map((item) => {
                const active = currentPath === normalizePath(item.href);
                return (
                  <a
                    href={item.href}
                    class:list={[
                      "whitespace-nowrap rounded-md border px-3 py-2 text-sm font-medium",
                      active
                        ? "border-brand-700 bg-brand-50 text-brand-900"
                        : "border-line bg-white text-muted"
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })
            }
          </nav>
        </header>

        <main class="px-4 py-6 sm:px-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
