PUBLIC_APP_ENV=local

# Server-side API Gateway base URL. Keep the /api/v1 prefix.
API_BASE_URL=http://localhost:8080/api/v1
API_TIMEOUT_MS=30000

# Temporary fallback for older local setups. Prefer API_BASE_URL.
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Astro server session cookie. The cookie is HttpOnly.
ADMIN_SESSION_COOKIE_NAME=motodi_admin_session
ADMIN_SESSION_COOKIE_SECURE=false
